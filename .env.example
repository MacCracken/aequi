# Aequi Environment Variables
# Copy this file to .env and adjust for your environment.
#
# The JSON *_CONFIG variables are validated at startup: if one is set but does
# not parse (unknown or missing fields, wrong types), the server refuses to
# start. Leave a variable unset or empty to disable that integration.

# ── Server mode (aequi-server) ──────────────────────────────────────────────

# Path to the SQLite database file
# AEQUI_DB_PATH=./data/ledger.db

# Address and port to listen on (defaults: 0.0.0.0 and 8060)
# AEQUI_BIND_ADDR=127.0.0.1
# AEQUI_PORT=8060

# API key for Bearer token authentication (use a long random value, e.g.
# `openssl rand -hex 32`). Authentication is REQUIRED: the server refuses to
# start without AEQUI_API_KEY or AEQUI_OIDC_CONFIG unless AEQUI_BIND_ADDR is a
# loopback address or AEQUI_INSECURE_NO_AUTH=1 is set.
# AEQUI_API_KEY=your-secret-api-key

# Run without authentication on a non-loopback address. Dangerous: anyone who
# can reach the port can read and modify the ledger.
# AEQUI_INSECURE_NO_AUTH=1

# Log format: "text" (default) or "json" for structured logging
# AEQUI_LOG_FORMAT=text

# CORS allowed origins (comma-separated), or * for any origin
# AEQUI_CORS_ORIGINS=http://localhost:1420,http://localhost:3000

# ── OIDC authentication (optional) ──────────────────────────────────────────

# issuer must equal the tokens' `iss` claim; audience is your client ID.
# Without allowed_subjects / allowed_emails, ANY account the issuer
# authenticates for this audience gets full access. allowed_emails only
# matches tokens whose email_verified claim is true.
# AEQUI_OIDC_CONFIG={"issuer":"https://accounts.google.com","audience":"your-client-id","allowed_emails":["you@example.com"],"allowed_subjects":[]}

# ── Email delivery (optional, for invoice sending) ──────────────────────────

# SMTP: starttls=true for port 587 (STARTTLS), false for port 465 (implicit TLS).
# AEQUI_EMAIL_CONFIG={"backend":"smtp","from_name":"Your Business","from_email":"you@example.com","smtp":{"host":"smtp.example.com","port":587,"username":"user","password":"secret","starttls":true}}
#
# Resend:
# AEQUI_EMAIL_CONFIG={"backend":"resend","from_name":"Your Business","from_email":"invoices@yourdomain.com","api_key":"re_..."}

# ── Plaid integration (optional) ────────────────────────────────────────────

# environment: "sandbox", "development" or "production"
# AEQUI_PLAID_CONFIG={"client_id":"...","secret":"...","environment":"sandbox"}

# ── Stripe integration (optional) ───────────────────────────────────────────

# Webhook signing secret for Stripe event verification
# STRIPE_WEBHOOK_SECRET=whsec_...
