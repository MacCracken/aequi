{
  "identifier": "default",
  "description": "Desktop capability — grants core IPC, native file dialogs for receipt intake, and writing camera captures to $APPDATA/captures (ingest_receipt deletes them once stored).",
  "platforms": ["macOS", "windows", "linux"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "dialog:allow-open",
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPDATA/captures" }, { "path": "$APPDATA/captures/**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$APPDATA/captures" }, { "path": "$APPDATA/captures/**" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$APPDATA/captures/**" }]
    }
  ]
}
